# UltraShip U-2 MQTT Bridge configuration
SCALE_DEVICE=/dev/ultraship-u2
INPUT_UNIT=kg

MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC=ultraship-u2/scale
MQTT_CLIENT_ID=ultraship-u2-scale
# MQTT_USERNAME=
# MQTT_PASSWORD=
# MQTT_TLS=true
# MQTT_CA_CERT=/etc/ssl/certs/ca-certificates.crt

DISCOVERY_PREFIX=homeassistant
DEVICE_ID=ultraship_u2_scale
DEVICE_NAME="UltraShip U-2 scale"

AVERAGE_INTERVAL=1
AVERAGE_RESOLUTION_GRAMS=0.1
PUBLISH_INTERVAL=300

USB_RETRY_INTERVAL=5
START_THRESHOLD_GRAMS=1000
PAUSE_THRESHOLD_GRAMS=500
PAUSE_RETRY_INTERVAL=10
PAUSE_URL=http://127.0.0.1:7125/printer/print/pause
DISABLE_PAUSE=false

LOG_LEVEL=INFO
